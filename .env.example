# ---------------------------------------------------------------
# EduShare environment configuration
# Copy to .env and adjust. Never commit real secrets.
# ---------------------------------------------------------------
NODE_ENV=development

# Public site
SITE_NAME="EduShare Uganda"
PUBLIC_SITE_URL=http://localhost:3000
ADMIN_SITE_URL=http://localhost:3001

# Internal service URLs (server-to-server)
API_INTERNAL_URL=http://localhost:4000
WEB_INTERNAL_URL=http://localhost:3000

# Database / Redis
DATABASE_URL=postgres://edushare:edushare@localhost:5432/edushare
REDIS_URL=redis://localhost:6379

# API
API_PORT=4000
# Comma separated origins allowed to call admin endpoints with credentials
ADMIN_ALLOWED_ORIGINS=http://localhost:3001
# Set to true when cookies are served over HTTPS (production)
COOKIE_SECURE=false
SESSION_IDLE_MINUTES=120
SESSION_ABSOLUTE_HOURS=12
# Secret used for anonymising visitor identifiers (rotate periodically)
ANALYTICS_SALT=change-me-analytics-salt
# Shared secret the API/worker uses to trigger Next.js on-demand revalidation
REVALIDATE_SECRET=change-me-revalidate-secret

# Storage
STORAGE_DRIVER=local
STORAGE_ROOT=./storage
# When true, the API responds with X-Accel-Redirect so Nginx streams files
STORAGE_ACCEL_REDIRECT=false
MAX_UPLOAD_MB=100

# Search
SEARCH_PROVIDER=postgres

# Initial super admin (used by `pnpm admin:create`)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe!2026
SEED_ADMIN_NAME="Site Administrator"

# Trust X-Forwarded-For / X-Real-IP (only when running behind Nginx)
TRUST_PROXY=false
# Optional ClamAV daemon for malware scanning of uploads
# CLAMAV_HOST=localhost
# CLAMAV_PORT=3310
# Admin UI (build-time)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_MAX_UPLOAD_MB=100

# ---------------------------------------------------------------- optional features
# Dedicated search engine (default: postgres)
# SEARCH_PROVIDER=meilisearch
# MEILI_HOST=http://localhost:7700
# MEILI_API_KEY=

# S3-compatible storage (AWS S3, MinIO, Cloudflare R2…) instead of the local disk
# STORAGE_DRIVER=s3
# S3_BUCKET=edushare
# S3_REGION=us-east-1
# S3_ENDPOINT=http://localhost:9000
# S3_FORCE_PATH_STYLE=true
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PREFIX=
# Redirect downloads to short-lived signed URLs (after tracking)
# S3_PRESIGNED_DOWNLOADS=true

# CDN: serve thumbnails and Next.js assets from another origin
# MEDIA_BASE_URL=https://cdn.example.com
# ASSET_PREFIX=https://cdn.example.com

# Office previews via LibreOffice (auto-detected; set a path if not on PATH)
# SOFFICE_PATH=/usr/bin/soffice
# LIBREOFFICE_DISABLED=true

# OCR for scanned PDFs/images (Tesseract)
# OCR_ENABLED=true
# OCR_LANGUAGES=eng
# OCR_MAX_PAGES=30

# AI summaries & classification suggestions (Claude)
# AI_ENRICH_ENABLED=true
# ANTHROPIC_API_KEY=
# ...or run the AI on a self-hosted Ledgerly server's Codex / Claude Code workers instead
# (create an API key in Ledgerly with only the "ai:write" scope):
# LEDGERLY_AI_URL=https://erp.example.com
# LEDGERLY_AI_API_KEY=
# Zip imports: apply AI titles/descriptions/classification and publish files that pass the
# quality checks (educational, ad-safe, no personal data, enough text, classified).
# AI_AUTOPILOT=true
# ZIP_MAX_MB=2048
# Google AdSense publisher id: adds the verification tag, Auto ads script and /ads.txt.
# ADSENSE_CLIENT_ID=ca-pub-0000000000000000
# AI_MODEL=claude-opus-5
# AI_AUTOFILL_DESCRIPTIONS=false
