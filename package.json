{
  "name": "edushare",
  "private": true,
  "version": "0.1.0",
  "description": "EduShare Uganda — free public educational resource library",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/* dev",
    "build": "pnpm -r --filter ./apps/* build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "pnpm --filter @edushare/database generate",
    "db:migrate": "pnpm --filter @edushare/database migrate",
    "db:seed": "pnpm --filter @edushare/database seed",
    "admin:create": "pnpm --filter @edushare/api admin:create"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.56.1",
    "@types/node": "^22.20.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.5.0",
    "pdf-lib": "^1.17.1",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^3.2.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@napi-rs/canvas",
      "esbuild",
      "sharp",
      "@node-rs/argon2",
      "msgpackr-extract",
      "unrs-resolver"
    ]
  }
}
